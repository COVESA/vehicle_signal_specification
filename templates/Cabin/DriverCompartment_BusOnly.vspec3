#
# All driver compartment signals (bus only section)
#
InteriorTemperature:
  comment: ¤FMS¤ Corresponds to SAE J1939 signal PGN 0xFEF5(AMB)/SPN 170 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.3.12
  datatype: float
  description: Temperature of air inside the part of the vehicle that encloses the driver and vehicle operating controls.
  type: sensor
  unit: Celsius
