#
# Root Vehicle Signal Specification file
#
# This top level vehicle specification file includes all other vspec
# files into a complete specification that can be processed
# by the tools available in https://github.com/COVESA/vss-tools
#

#
# The Vehicle branch for highlevel signals and attributes.
#
Vehicle:
  type: branch
  description: High-level vehicle data.
  metadata:
    namespace: Acea.OnboardApi

#include Vehicle/Vehicle.vspec Vehicle
#include Vehicle/VehicleTruckOnly.vspec Vehicle
#include Vehicle/VehicleBusOnly.vspec Vehicle

#---Vehicle.Powertrain branch
#Picked up from the VehicleSignalSpecification.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"VehicleSignalSpecification\",\"Name\":\"Vehicle.Powertrain\"}" }}

#---Vehicle.Powertrain.CombustionEngine branch
#Picked up from the VehicleSignalSpecification.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"VehicleSignalSpecification\",\"Name\":\"Vehicle.Powertrain.CombustionEngine\"}" }}
#include Powertrain/CombustionEngine.vspec Vehicle.Powertrain.CombustionEngine
#include Powertrain/CombustionEngineBusOnly.vspec Vehicle.Powertrain.CombustionEngine
#include Powertrain/CombustionEngineTruckOnly.vspec Vehicle.Powertrain.CombustionEngine

#---Vehicle.Powertrain.FuelSystem branch
#Picked up from the VehicleSignalSpecification.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"VehicleSignalSpecification\",\"Name\":\"Vehicle.Powertrain.FuelSystem\"}" }}
#include Powertrain/FuelSystem.vspec Vehicle.Powertrain.FuelSystem
#include Powertrain/FuelSystemGaseous.vspec Vehicle.Powertrain.FuelSystem

#---Vehicle.Powertrain.TractionBattery branch:
#Picked up from the VehicleSignalSpecification.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"VehicleSignalSpecification\",\"Name\":\"Vehicle.Powertrain.TractionBattery\"}" }}
#include Powertrain/TractionBattery.vspec Vehicle.Powertrain.TractionBattery
#include Powertrain/TractionBatteryBusOnly.vspec Vehicle.Powertrain.TractionBattery

#---Vehicle.Powertrain.Transmission branch:
#Picked up from the VehicleSignalSpecification.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"VehicleSignalSpecification\",\"Name\":\"Vehicle.Powertrain.Transmission\"}" }}
#include Powertrain/Transmission.vspec Vehicle.Powertrain.Transmission
#include Powertrain/TransmissionBusOnly.vspec Vehicle.Powertrain.Transmission

#include Powertrain/PowerTakeOff.vspec Vehicle.Powertrain

#---Bus only variant, alternator signals
#include Powertrain/AlternatorBusOnly.vspec Vehicle.Powertrain

Vehicle.Powertrain.PropulsionSystem:
  description: Propulsion system information.
  type: branch
#include Powertrain/PropulsionSystemBusOnly.vspec Vehicle.Powertrain.PropulsionSystem

# Chassis signals and attributes.
# Includes steering, suspension, wheels, brakes, etc
#---Vehicle.Chassis branch:
#Picked up from the VehicleSignalSpecification.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"VehicleSignalSpecification\",\"Name\":\"Vehicle.Chassis\"}" }}
#include Chassis/Chassis.vspec Vehicle.Chassis
#include Chassis/ChassisBusOnly.vspec Vehicle.Chassis

#---Vehicle.Exterior branch:
#Picked up from the VehicleSignalSpecification.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"VehicleSignalSpecification\",\"Name\":\"Vehicle.Exterior\"}" }}
#include Vehicle/Exterior.vspec Vehicle.Exterior
#---Can be included Vehicle/ExteriorTruckOnly.vspec and Vehicle/ExteriorBusOnly.vspec

# Advanced Driver Assist Systems signals and attributes.
#---Vehicle.ADAS branch:
#Picked up from the VehicleSignalSpecification.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"VehicleSignalSpecification\",\"Name\":\"Vehicle.ADAS\"}" }}
#include ADAS/ADAS.vspec Vehicle.ADAS

# Service information (truck only)
#---Vehicle.Service branch:
#Picked up from the VehicleSignalSpecification.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"VehicleSignalSpecification\",\"Name\":\"Vehicle.Service\"}" }}
#Truck only:
#include Vehicle/ServiceTruckOnly.vspec Vehicle.Service

#---Vehicle.Cabin branch:
#Picked up from the VehicleSignalSpecification.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"VehicleSignalSpecification\",\"Name\":\"Vehicle.Cabin\"}" }}
#include Cabin/Cabin.vspec Vehicle.Cabin

#---Vehicle.Body branch:
#Picked up from the VehicleSignalSpecification.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"VehicleSignalSpecification\",\"Name\":\"Vehicle.Body\"}" }}
#include Body/Body.vspec Vehicle.Body

#---Vehicle.HMI branch:
Vehicle.HMI:
  description: Vehicle HMI signals
  type: branch
#include Vehicle/HMI.vspec Vehicle.HMI
