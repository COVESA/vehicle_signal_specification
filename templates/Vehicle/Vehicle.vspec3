#
# Highlevel vehicle signals and attributes.
#

#
#---VSS Versioning information
##Picked up from the Vehicle.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"Vehicle\",\"Name\":\"VersionVSS\"}" }}
#Picked up from the Vehicle.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"Vehicle\",\"Name\":\"VersionVSS.Major\"}" }}
#Picked up from the Vehicle.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"Vehicle\",\"Name\":\"VersionVSS.Minor\"}" }}
#Picked up from the Vehicle.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"Vehicle\",\"Name\":\"VersionVSS.Patch\"}" }}
#Picked up from the Vehicle.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"Vehicle\",\"Name\":\"VersionVSS.Label\"}" }}

#
#---ACEA Versioning information
VersionACEA:
  description: Supported Version of the ACEA onboard API.
  type: branch

VersionACEA.Major:
  datatype: uint32
  default: 1
  description: Supported Version of the ACEA onboard API - Major version.
  type: attribute

VersionACEA.Minor:
  datatype: uint32
  default: 0
  description: Supported Version of the ACEA onboard API - Minor version.
  type: attribute

VersionACEA.Patch:
  datatype: uint32
  default: 0
  description: Supported Version of the ACEA onboard API - Patch version.
  type: attribute

VersionACEA.Label:
  comment: ACEA onboard API projects typically use "dev" for latest master, and empty string for released versions.
  datatype: string
  default: dev
  description: Label to further describe the version.
  type: attribute

#---VehicleIdentification branch
#Picked up from the Vehicle.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"Vehicle\",\"Name\":\"VehicleIdentification\"}" }}
#---VehicleIdentification.VIN
#Picked up from the Vehicle.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"Vehicle\",\"Name\":\"VehicleIdentification.VIN\",\"comment\":\"¤FMS¤Corresponds SAE J1939 signal PGN 0xFEEC(VI)/SPN 237 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.1.5\"}" }}

#---TraveledDistance
#Picked up from the Vehicle.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"Vehicle\",\"Name\":\"TraveledDistance\",\"comment\":\"¤FMS¤Corresponds SAE J1939 signal PGN 0xFEC1(VDHR)/SPN 917 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.1.7\",\"datatype\":\"uint64\"}" }}

#---IsMoving
#Picked up from the Vehicle.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"Vehicle\",\"Name\":\"IsMoving\",\"comment\":\"¤FMS¤Corresponds SAE J1939 signal PGN 0xFE6C(TCO1)/SPN 1611 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.1.8\"}" }}

#---Speed
#Picked up from the Vehicle.vspec {{ template "tmplCommon/PickUpdate.go.tmpl" "{\"DataSource\":\"Vehicle\",\"Name\":\"Speed\",\"comment\":\"¤FMS¤Corresponds SAE J1939 signal PGN 0xFEF1(CCVS1)/SPN 84 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.2.1(truck) & 1.3.1(bus)\"}" }}

#---Current datetime
CurrentDateTime:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xFEE6(CT1)/SPN 959-964 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.3.5
  datatype: string
  unit: iso8601
  description: Current date and time provided by the vehicle's internal clock.
  type: sensor

