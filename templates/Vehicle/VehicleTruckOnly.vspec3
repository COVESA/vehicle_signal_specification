#
# Highlevel vehicle signals and attributes (truck only).
#

#---GrossCombinationVehicleWeight
GrossCombinationVehicleWeight:
  comment: ¤FMS¤Corresponds SAE J1939 signal PGN 0xFE70(CVW)/SPN 1760 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.2.5
  datatype: uint32
  description: The total weight of the vehicle and all attached trailers.
  type: sensor
  unit: kg

