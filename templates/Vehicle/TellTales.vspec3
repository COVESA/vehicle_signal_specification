#
# All TellTales signals
#
Status:
  datatype: uint8
  description: Status of the telltale. The interpretation of the status is manufacturer dependant.
  type: sensor
  enum:
    'OFF': 0
    'COND_RED': 1
    'COND_YELLOW': 2
    'COND_INFO': 3

TellTale1.Status:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xFD7D(FMS1) TellTaleId 1 "Cooling air conditioning" in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.1.16

