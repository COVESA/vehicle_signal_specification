#
# All body signals for bus doors.
#

# Doors branch
Doors:
  description: Bus door information.
  type: branch
  instances:
    - Door[1,10]

# One signal for all the doors, not instantiated
Doors.IsEnabledAtLeastOne:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xFE4E(DC1)/SPN3411 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.3.3
  instantiate: false
  datatype: boolean
  description: Signal indicating the status of all bus doors.
              True if at least 1 bus door is enabled, False otherwise.
              Enabled means the bus doors are able to be automatically opened or Closed.
  type: sensor

# One signal for all the doors, not instantiated
Doors.PositionOfDoors:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xFE4E(DC1)/SPN1821 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.3.3
  instantiate: false
  datatype: uint8
  description: Signal indicating the actual position of the doors.
  enum:
    'AT_LEAST_ONE_DOOR_OPEN': 0
    'CLOSING_LAST_DOOR': 1
    'ALL_DOORS_CLOSED': 2
  type: sensor

# Per door signals, instantiated for each door
Doors.IsLocked:
  datatype: boolean
  description: Indication of the lock status of the door. Doors cannot be operated by the driver or a passenger when locked.
  type: sensor

Doors.IsOpen:
  datatype: boolean
  description: Indication of the open status of the door.
  type: sensor

Doors.IsEnabled:
  datatype: boolean
  description:  Indication of the enablement status of the door. Door can be opened by a passenger when enabled.
  type: sensor

# The comments for each door signal
Doors.Door1.IsLocked:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xFDA5(DC2)/SPN3412 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.3.4

