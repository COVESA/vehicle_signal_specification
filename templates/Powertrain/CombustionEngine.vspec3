#
# ENGINE SPECIFICATION FILE
#
# This vehicle specification file, included by the top level
# root.vspec file, contains all engine-based signals.
#

#Not found in the standard VSS spec, only MaxTorque and Torque in Nm are found
ActualPercentTorque:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xF004(EEC1)/SPN 513 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.1.3
  datatype: uint8
  description: The calculated output torque of the engine as a percent of reference engine torque.
  max: 100
  type: sensor
  unit: percent

