#
# Fuel system for gas vehicles
#
TotalConsumptionGaseous:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xFEAF(GFC)/SPN 1040 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.1.19
  datatype: double
  description: Total fuel consumed (trip drive fuel + trip PTO governor moving fuel + trip PTO governor non-moving fuel + trip idle fuel) over the life of the engine.
  type: sensor
  unit: kg

