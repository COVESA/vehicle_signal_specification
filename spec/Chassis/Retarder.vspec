RetarderTorqueMode:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xF000(ERC1)/SPN 900 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.1.20
  datatype: uint8
  description: State signal which indicates which retarder torque mode is currently generating, limiting or controlling the torque. 0 = No Request, 1-14 = torque request or identified function controls retarder.
  min: 0
  max: 15
  type: sensor


ActualRetarderPercentTorque:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xF000(ERC1)/SPN520 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.1.20
  datatype: uint8
  description: Actual braking torque of the retarder as a percent of retarder configuration reference torque SPN 556
  min: 0
  max: 125
  type: sensor
  unit: percent

RetarderSelection:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xF000(ERC1)/SPN1716 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.1.20
  datatype: float
  description: The position of the driver/'s selector for retarders that are not part of the engine system, expressed as percent and
              determined by the ratio of current position to the maximum possible position. The physical device may be a lever, rotary dial, combination of switches, or other device that the driver can
              use to select the type or amount of retardation needed.
  min: 0
  max: 100
  type: sensor
  unit: percent
