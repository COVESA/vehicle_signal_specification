#
# Chassis signals and attributes
#

#---Chassis.Brake branch
#Picked up from the Chassis.vspec
Brake:
  description: Brake system signals
  type: branch

#include AirBrakeSystem.vspec Brake
#include Retarder.vspec Brake

#---Chassis.Brake.PedalPosition
#Picked up from the Chassis.vspec
Brake.PedalPosition:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xF001(EBC1)/SPN 521 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.1.17
  datatype: uint8
  description: Brake pedal position as percent. 0 = Not depressed. 100 = Fully depressed.
  max: 100
  metadata:
    overridden:
      - comment
  min: 0
  type: sensor
  unit: percent


Brake.IsBrakePedalPressed:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xFEF1(CCVS1)/SPN 597 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.2.1(truck) & 1.3.1(bus)
  datatype: boolean
  description: Switch signal which indicates that the driver operated brake foot pedal is being pressed.
              This brake foot pedal is controlling the vehicles' service brake (total vehicle braking application, not park brakes).
              It is necessary for safe drivetrain behaviour that the switch activates before the physical braking components are activated
              (i.e. disengage the cruise control function prior to the activation of friction brakes).
  type: sensor


#---Chassis.AxleCount
#Picked up from the Chassis.vspec
AxleCount:
  datatype: uint8
  default: 2
  description: Number of axles on the vehicle
  type: attribute


#---Chassis.Axle branch
#ATTENTION! The number of axles below is just an example and should be adjusted to the actual vehicle configuration!
Axle:
  instances:
    - Row[1,2]
  type: branch
  description: Axle signals

#---Chassis.Axle.WheelCount
#Picked up from the Chassis.vspec
Axle.WheelCount:
  datatype: uint8
  description: Number of wheels on the axle
  type: attribute


Axle.Weight:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xFEEA(VW)/SPN 582 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.1.21
  datatype: uint16
  description: The weight of the axle in kg.
  type: sensor
  unit: kg

#---Axle.Wheel branches
#ATTENTION! The number of wheels on each axle below is just an example and should be adjusted to the actual vehicle configuration!
Axle.Row1.Wheel:
  instances: ["Pos7", "Pos9"]
  type: branch
  description: Wheel signals for axle
#include Wheel.vspec Axle.Row1.Wheel

Axle.Row2.Wheel:
  instances: ["Pos6","Pos7", "Pos9", "Pos10"]
  type: branch
  description: Wheel signals for axle
#include Wheel.vspec Axle.Row2.Wheel

#---Chassis.ParkingBrake branch
#Picked up from the Chassis.vspec
ParkingBrake:
  description: Parking brake signals
  type: branch

#---Chassis.ParkingBrake.IsEngaged
#Picked up from the Chassis.vspec
ParkingBrake.IsEngaged:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xFEF1(CCVS1)/SPN 70 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.2.1(truck) & 1.3.1(bus)
  datatype: boolean
  description: Parking brake status. True = Parking Brake is Engaged. False = Parking Brake is not Engaged.
  metadata:
    overridden:
      - comment
      - type
  type: sensor


#---Chassis.Accelerator branch
#Picked up from the Chassis.vspec
Accelerator:
  description: Accelerator signals
  type: branch

#---Chassis.Accelerator.PedalPosition
#Picked up from the Chassis.vspec
Accelerator.PedalPosition:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xF003(EEC2)/SPN 91 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.2.2(truck) & 1.3.2(bus)
  datatype: uint8
  description: Accelerator pedal position as percent. 0 = Not depressed. 100 = Fully depressed.
  max: 100
  metadata:
    overridden:
      - comment
  min: 0
  type: sensor
  unit: percent
