#
# A single HVAC station in the vehicle.
#

FanSpeed:
  datatype: uint8
  type: actuator
  min: 0
  max: 100
  unit: percent
  description: Fan speed of the HVAC station. 0 = off; 100 = maximum.

Temperature:
  datatype: float
  type: actuator
  unit: Celsius
  description: Target temperature of the HVAC station.

AirDistribution:
  datatype: string
  type: actuator
  allowed: ["UP", "MIDDLE", "DOWN"]
  description: Direction of the airstream of the HVAC station.
