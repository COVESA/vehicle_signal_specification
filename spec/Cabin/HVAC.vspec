#
# All HVAC-originated signals
#

Station:
  type: branch
  instances:
    - Row[1,4]
    - ["Driver", "Passenger"]
  description: HVAC (heating, ventilation, and air conditioning) for a single station in the vehicle.
#include SingleHVACStation.vspec Station

IsRecirculationActive:
  datatype: boolean
  type: actuator
  description: Indicates whether air recirculation of the HVAC system is active. True = active; False = not active.

IsFrontDefrosterActive:
  datatype: boolean
  type: actuator
  description: Indicates whether the front defroster is active. True = active; False = not active.

IsRearDefrosterActive:
  datatype: boolean
  type: actuator
  description: Indicates whether the rear defroster is active. True = active; False = not active.

IsAirConditioningActive:
  datatype: boolean
  type: actuator
  description: Indicates whether air conditioning is active. True = active; False = not active.

AmbientAirTemperature:
  datatype: float
  type: sensor
  unit: Celsius
  description: Ambient air temperature inside the vehicle.

#include include/PowerOptimize.vspec
