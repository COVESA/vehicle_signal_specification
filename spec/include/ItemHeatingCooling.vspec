HeatingCooling:
  datatype: int8
  type: actuator
  min: -100
  max: 100
  unit: percent
  description: >-
    Requested heating or cooling level of the item. -100 = maximum cooling; 0 = heating/cooling deactivated; 100 =
    maximum heating.
