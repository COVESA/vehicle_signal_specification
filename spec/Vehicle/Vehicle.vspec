#
# Highlevel vehicle signals and attributes.
#

#
#---VSS Versioning information
##Picked up from the Vehicle.vspec 
VersionVSS:
  description: Supported Version of VSS.
  type: branch

#Picked up from the Vehicle.vspec 
VersionVSS.Major:
  datatype: uint32
  default: 7
  description: Supported Version of VSS - Major version.
  type: attribute

#Picked up from the Vehicle.vspec 
VersionVSS.Minor:
  datatype: uint32
  default: 0
  description: Supported Version of VSS - Minor version.
  type: attribute

#Picked up from the Vehicle.vspec 
VersionVSS.Patch:
  datatype: uint32
  default: 0
  description: Supported Version of VSS - Patch version.
  type: attribute

#Picked up from the Vehicle.vspec 
VersionVSS.Label:
  comment: COVESA VSS project typically use dev for latest master, and empty string for released versions.
  datatype: string
  default: dev
  description: Label to further describe the version.
  type: attribute


#
#---ACEA Versioning information
VersionACEA:
  description: Supported Version of the ACEA onboard API.
  type: branch

VersionACEA.Major:
  datatype: uint32
  default: 1
  description: Supported Version of the ACEA onboard API - Major version.
  type: attribute

VersionACEA.Minor:
  datatype: uint32
  default: 0
  description: Supported Version of the ACEA onboard API - Minor version.
  type: attribute

VersionACEA.Patch:
  datatype: uint32
  default: 0
  description: Supported Version of the ACEA onboard API - Patch version.
  type: attribute

VersionACEA.Label:
  comment: ACEA onboard API projects typically use "dev" for latest master, and empty string for released versions.
  datatype: string
  default: dev
  description: Label to further describe the version.
  type: attribute

#---VehicleIdentification branch
#Picked up from the Vehicle.vspec 
VehicleIdentification:
  description: Attributes that identify a vehicle.
  type: branch

#---VehicleIdentification.VIN
#Picked up from the Vehicle.vspec 
VehicleIdentification.VIN:
  comment: ¤FMS¤Corresponds SAE J1939 signal PGN 0xFEEC(VI)/SPN 237 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.1.5
  datatype: string
  description: 17-character Vehicle Identification Number (VIN) as defined by ISO 3779.
  metadata:
    overridden:
      - comment
  pattern: ^([0-9A-HJ-NPR-Z]{3})([0-9A-HJ-NPR-Z]{6})([0-9A-HJ-NPR-Z]{4}[0-9]{4})$
  type: attribute


#---TraveledDistance
#Picked up from the Vehicle.vspec 
TraveledDistance:
  comment: ¤FMS¤Corresponds SAE J1939 signal PGN 0xFEC1(VDHR)/SPN 917 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.1.7
  datatype: uint64
  description: Odometer reading, total distance traveled during the lifetime of the vehicle.
  metadata:
    overridden:
      - comment
      - datatype
  type: sensor
  unit: m


#---IsMoving
#Picked up from the Vehicle.vspec 
IsMoving:
  comment: ¤FMS¤Corresponds SAE J1939 signal PGN 0xFE6C(TCO1)/SPN 1611 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.1.8
  datatype: boolean
  description: Indicates whether the vehicle is stationary or moving.
  metadata:
    overridden:
      - comment
  type: sensor


#---Speed
#Picked up from the Vehicle.vspec 
Speed:
  comment: ¤FMS¤Corresponds SAE J1939 signal PGN 0xFEF1(CCVS1)/SPN 84 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.2.1(truck) & 1.3.1(bus)
  datatype: float
  description: Vehicle speed.
  metadata:
    overridden:
      - comment
  type: sensor
  unit: km/h


#---Current datetime
CurrentDateTime:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xFEE6(CT1)/SPN 959-964 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.3.5
  datatype: string
  unit: iso8601
  description: Current date and time provided by the vehicle's internal clock.
  type: sensor

