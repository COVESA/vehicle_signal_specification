#
# Resources attributes and signals
#

Power:
  datatype: float
  type: sensor
  unit: W
  description: Power consumption of the control unit.

# Human check of description required: unclear which temperature (chip, board, housing) is measured
Temperature:
  datatype: float
  type: sensor
  unit: Celsius
  description: Temperature of the control unit.

Utilization:
  type: branch
  description: Utilization of the control unit's resources. May contain elements such as CPU and memory utilization.

Utilization.CPU:
  datatype: float
  type: sensor
  unit: percent
  min: 0
  max: 100
  description: CPU utilization of the control unit.

Utilization.Memory:
  datatype: float
  type: sensor
  unit: percent
  min: 0
  max: 100
  description: Memory utilization of the control unit.
