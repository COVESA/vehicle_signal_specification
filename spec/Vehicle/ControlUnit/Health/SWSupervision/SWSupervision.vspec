#
# Software supervision attributes and signals, based on AUTOSAR standard
#

IsAliveTriggered:
  datatype: boolean
  type: sensor
  description: >-
    Indicates whether the alive supervision of the control unit was triggered. True = triggered; False = not triggered.

IsDeadlineTriggered:
  datatype: boolean
  type: sensor
  description: >-
    Indicates whether the deadline supervision of the control unit was triggered. True = triggered; False = not
    triggered.

IsLogicalTriggered:
  datatype: boolean
  type: sensor
  description: >-
    Indicates whether the logical supervision of the control unit was triggered. True = triggered; False = not
    triggered.

IsWatchdogTriggered:
  datatype: boolean
  type: sensor
  description: >-
    Indicates whether the watchdog deadline of the control unit was triggered. True = triggered; False = not triggered.
