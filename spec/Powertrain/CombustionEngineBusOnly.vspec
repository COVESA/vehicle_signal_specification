#
# ENGINE SPECIFICATION FILE, BUS ONLY SECTION
#
#

#---CombustionEngine.EngineOil branch (bus only)
#Picked up from the CombustionEngine.vspec 
EngineOil:
  description: Signals related to the engine oil
  type: branch

#---CombustionEngine.EngineOil.Temperature (bus only)
#Picked up from the CombustionEngine.vspec 
EngineOil.Temperature:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xFEEE(ET1)/SPN 175 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.3.11
  datatype: float
  description: EOT, Engine oil temperature.
  metadata:
    overridden:
      - comment
  type: sensor
  unit: Celsius

#---CombustionEngine.EOP (bus only)
#Picked up from the CombustionEngine.vspec 
EOP:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xFEEF(EFL/P1)/SPN 100 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.3.16
  datatype: uint16
  description: Engine oil pressure.
  metadata:
    overridden:
      - comment
  type: sensor
  unit: kPa

