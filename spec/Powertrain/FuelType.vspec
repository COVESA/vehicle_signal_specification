#
# One fuel type signals
#

#---RelativeLevel
#Picked up from the FuelSystem.vspec
RelativeLevel:
  comment: ¤FMS¤ Overridden by an overlay
  datatype: uint8
  description: Level of the fuel type as percent of capacity. 0 = empty. 100 = full.
  max: 100
  metadata:
    overridden:
      - comment
      - description
  min: 0
  type: sensor
  unit: percent
