#
# TRANSMISSION SPECIFICATION FILE for buses
#

#---Transmission.SelectedGear (bus only)
#Picked up from the Transmission.vspec 
SelectedGear:
  comment: ¤FMS¤Corresponds SAE J1939 signal PGN 0xF005(ETC2)/SPN 524 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.3.7
  datatype: int8
  description: The selected gear. 0=Neutral, 1/2/..=Forward, -1/-2/..=Reverse, 126=Park, 127=Drive.
  metadata:
    overridden:
      - comment
      - type
  type: sensor

#---Transmission.CurrentGear (bus only)
#Picked up from the Transmission.vspec 
CurrentGear:
  comment: ¤FMS¤Corresponds SAE J1939 signal PGN 0xF005(ETC2)/SPN 523 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.3.7
  datatype: int8
  description: The current gear. 0=Neutral, 1/2/..=Forward, -1/-2/..=Reverse.
  metadata:
    overridden:
      - comment
  type: sensor

#---Transmission.Temperature (bus only)
#Picked up from the Transmission.vspec 
Temperature:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xFEEF(EFL/P1)/SPN100 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.3.17
  datatype: float
  description: The current transmission fluid temperature.
  metadata:
    overridden:
      - comment
      - description
  type: sensor
  unit: Celsius

