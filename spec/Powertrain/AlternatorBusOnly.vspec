#
# Bus alternator signals
#

Alternators:
  type: branch
  instances:
    - Alternator[1,4]
  description: Bus alternators.

Alternators.IsCharging:
  comment: Status of the alternator.
  datatype: boolean
  description:  Indicates the current status of the alternator.
  type: sensor

Alternators.Alternator1.IsCharging:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xFED5(AS)/SPN 3353 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.3.6
Alternators.Alternator2.IsCharging:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xFED5(AS)/SPN 3354 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.3.6
Alternators.Alternator3.IsCharging:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xFED5(AS)/SPN 3355 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.3.6
Alternators.Alternator4.IsCharging:
  comment: ¤FMS¤ Corresponds SAE J1939 signal PGN 0xFED5(AS)/SPN 3356 in ACEA FMS-Standard description version 05 11.11.2025 chapter 1.3.6
