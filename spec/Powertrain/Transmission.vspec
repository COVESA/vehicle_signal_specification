#
# TRANSMISSION SPECIFICATION FILE
#
# This vehicle specification file, included by the top level
# root.vspec file, contains all transmission-originated signals and attributes
#

Type:
  datatype: string
  type: attribute
  allowed: ["UNKNOWN", "SEQUENTIAL", "H", "AUTOMATIC", "DSG", "CVT"]
  default: "UNKNOWN"
  description: >-
    Transmission type. H = manual H-pattern gearbox; DSG = dual-clutch gearbox; CVT = continuously variable
    transmission.

GearCount:
  datatype: int8
  type: attribute
  default: 0
  description: Number of forward gears in the transmission. -1 = CVT.

DriveType:
  datatype: string
  type: attribute
  allowed:
    [
      "UNKNOWN",
      "FORWARD_WHEEL_DRIVE",
      "REAR_WHEEL_DRIVE",
      "ALL_WHEEL_DRIVE",
      "FOUR_WHEEL_DRIVE",
    ]
  default: "UNKNOWN"
  description: Drive type of the vehicle, describing which wheels are driven.
  comment:
    ALL_WHEEL_DRIVE and FOUR_WHEEL_DRIVE are recorded as distinct values in registration
    and type data. Assignment follows the manufacturer's or registration authority's
    designation.

#
# Current odometer reading for the transmission
#
# Note that this signal refers to the distance travelled by the transmission and not the vehicle.
# This signal might differ from Vehicle.TravelledDistance if the transmission
# has been replaced during the lifetime of the vehicle.
# If the transmission is moved from one vehicle to another the signal shall also include
# distance travelled in previous vehicles.
#
TravelledDistance:
  datatype: float
  type: sensor
  unit: km
  description: Odometer reading, total distance traveled during the lifetime of the transmission.

#
# Current gear
#
CurrentGear:
  datatype: int8
  type: sensor
  description: Current gear of the transmission. 0 = neutral; 1/2/... = forward gears; -1/-2/... = reverse gears.

#
# Selected gear
#
SelectedGear:
  datatype: int8
  type: actuator
  description: >-
    Selected gear of the transmission. 0 = neutral; 1/2/... = forward gears; -1/-2/... = reverse gears; 126 = park; 127
    = drive.

IsParkLockEngaged:
  datatype: boolean
  type: actuator
  description: Indicates whether the transmission park lock is engaged. True = engaged; False = disengaged.

IsLowRangeEngaged:
  datatype: boolean
  type: actuator
  description: >-
    Indicates whether the gearbox is in low range mode. True = low range engaged; False = normal/high range engaged.
  comment:
    The possibility to switch between low and high gear range is typically only available
    in heavy vehicles and off-road vehicles.

IsElectricalPowertrainEngaged:
  datatype: boolean
  type: actuator
  description: >-
    Indicates whether the electrical powertrain is mechanically connected to the drivetrain. True = connected/engaged;
    False = disconnected/disengaged.
  comment:
    In some hybrid solutions it is possible to disconnect/disengage the electrical powertrain mechanically
    to avoid induced voltage reaching a too high level when driving at high speed.

#
# Current mode
#
PerformanceMode:
  datatype: string
  type: actuator
  allowed: ["NORMAL", "SPORT", "ECONOMY", "SNOW", "RAIN"]
  description: Current gearbox performance mode.

#
# Current gearchange mode
#
GearChangeMode:
  datatype: string
  type: actuator
  allowed: ["MANUAL", "AUTOMATIC"]
  description: Gear change mode of the gearbox, either automatic or manual (paddle).

#
# Gearbox temperature
#
Temperature:
  datatype: float
  type: sensor
  unit: Celsius
  description: Current temperature of the gearbox.

#
# Clutch
#
IsClutchPedalPressed:
  datatype: boolean
  type: sensor
  description: >-
    Indicates whether the clutch pedal is pressed, as reported by the clutch switch. True = pressed; False = not
    pressed.
  comment: >-
    It is necessary for safe drivetrain behavior that the clutch switch is set before the clutch is opened (cruise
    control function).

ClutchEngagement:
  datatype: float
  type: actuator
  unit: percent
  min: 0
  max: 100
  description: Degree of clutch engagement. 0% = clutch fully disengaged; 100% = clutch fully engaged.

ClutchWear:
  datatype: uint8
  type: sensor
  unit: percent
  max: 100
  description: Clutch wear as a percent. 0 = no wear. 100 = worn.

DiffLockFrontEngagement:
  datatype: float
  type: actuator
  unit: percent
  min: 0
  max: 100
  description: Engagement of the front differential lock. 0% = fully disengaged; 100% = fully engaged.

DiffLockRearEngagement:
  datatype: float
  type: actuator
  unit: percent
  min: 0
  max: 100
  description: Engagement of the rear differential lock. 0% = fully disengaged; 100% = fully engaged.

TorqueDistribution:
  datatype: float
  type: actuator
  unit: percent
  min: -100
  max: 100
  description: >-
    Torque distribution between front and rear axle in percent. -100% = full torque to front axle; 0% = 50:50
    front/rear; 100% = full torque to rear axle.
