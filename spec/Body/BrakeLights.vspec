IsActive:
  datatype: string
  type: actuator
  allowed: ["INACTIVE", "ACTIVE", "ADAPTIVE"]
  description: >-
    Indicates if the brake light is active. INACTIVE = light is off; ACTIVE = light is on; ADAPTIVE = brake light is
    indicating emergency braking.

IsDefect:
  datatype: boolean
  type: sensor
  description: Indicates if the light is defective. True = Defective. False = Not defective.
