#
# All body signals for bus doors.
#

# Bus doors branch
BusDoors:
  type: branch
  instances:
    - Door[1,10]
  description: Bus door information.

# One signal for all the doors, not instantiated
BusDoors.IsEnabledAtLeastOne:
  instantiate: false
  datatype: boolean
  type: sensor
  description: >-
    Indicates if at least one bus door is enabled. True = At least one bus door enabled. False = No bus door enabled.
    Enabled means a bus door is able to be automatically opened or closed.

# One signal for all the doors, not instantiated
BusDoors.PositionOfDoors:
  instantiate: false
  datatype: uint8
  enum:
    "AT_LEAST_ONE_DOOR_OPEN": 0
    "CLOSING_LAST_DOOR": 1
    "ALL_DOORS_CLOSED": 2
  type: sensor
  description: Actual position of the bus doors.

# Per door signals, instantiated for each door
BusDoors.IsLocked:
  datatype: boolean
  type: sensor
  description: >-
    Indicates if the bus door is locked. True = Locked, the bus door cannot be operated by the driver or a passenger.
    False = Not locked.

BusDoors.IsOpen:
  datatype: boolean
  type: sensor
  description: Indicates if the bus door is open. True = Open. False = Closed.

BusDoors.IsEnabled:
  datatype: boolean
  type: sensor
  description: >-
    Indicates if the bus door is enabled. True = Enabled, the bus door can be opened by a passenger. False = Not enabled.
